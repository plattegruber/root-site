# Local env for `pnpm run dev` (Vite) — copy to .env (gitignored).
#
# Only the Vite dev server reads this file. The deployed Worker gets its
# PUBLIC_* values from `vars` in wrangler.jsonc (or `wrangler secret put`)
# and hands them to the browser at runtime via /_app/env.js, so nothing
# here is baked into the build. `pnpm run preview` reads .dev.vars instead.

# === PostHog (product analytics, session replay, heatmaps) ===
# Project API key from PostHog → Settings → Project → "Project API key".
# It is a write-only public key, so it is safe in client code. Without
# it, analytics is a no-op (and `pnpm run dev` logs one error saying so).
PUBLIC_POSTHOG_KEY=
# Ingestion host for the project's region. US Cloud (the default) is
# https://us.i.posthog.com, EU Cloud is https://eu.i.posthog.com.
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# === Cloudflare Web Analytics beacon (optional) ===
PUBLIC_CF_ANALYTICS_TOKEN=
