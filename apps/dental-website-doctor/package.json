{
	"name": "dental-website-doctor",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "node --import tsx src/server.ts",
		"build": "tsc && node scripts/build-widget.mjs",
		"start": "node dist/server.js",
		"typecheck": "tsc --noEmit",
		"test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
		"test:browser": "node --import tsx --test --test-isolation=none tests/browser.integration.ts",
		"sample": "node --import tsx scripts/sample.ts",
		"audit": "node --import tsx scripts/audit.ts",
		"package:plugin": "node scripts/package-plugin.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/ext-apps": "^1.0.1",
		"@modelcontextprotocol/sdk": "^1.27.1",
		"axe-core": "^4.11.1",
		"cheerio": "^1.2.0",
		"express": "^5.1.0",
		"https-proxy-agent": "^7.0.6",
		"ipaddr.js": "^2.2.0",
		"playwright": "^1.56.1",
		"robots-parser": "^3.0.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"@types/express": "^5.0.3",
		"@types/node": "^24.10.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
