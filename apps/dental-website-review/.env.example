# Local V0 needs no external account. Copy to .env; start with node --env-file=.env.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Set to false for an HTML-only audit. Missing Chromium is reported as not tested.
BROWSER_ENABLED=true
PAGESPEED_ENABLED=false
# Optional Google Cloud keys: enable respective APIs, restrict keys to API + server IP.
PAGESPEED_API_KEY=
GOOGLE_PLACES_API_KEY=
# Remote staging only. Do not enable public anonymous costly audits.
AUDIT_API_TOKEN=
MAX_CONCURRENT_AUDITS=2
